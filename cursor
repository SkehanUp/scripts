#!/usr/bin/env bash
# Usage: cursor [args]
# Description: Open Cursor IDE, or delegate to agent subcommand.
set -euo pipefail
if [[ "${1:-}" == "agent" ]]; then
  shift
  exec "$HOME/.local/bin/agent" "$@"
fi
if [[ -d /Applications/Cursor.app ]]; then
  exec open -a Cursor "$@"
fi
echo "Cursor.app not found; use 'agent' for Cursor Agent CLI" >&2
exit 1
