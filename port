#!/usr/bin/env bash

# Usage: port <port>
# Description: Show what is listening on a port.

set -e

if [ $# -ne 1 ]; then
  echo "Usage: port <port>"
  exit 1
fi

PORT="$1"

if ! [[ "$PORT" =~ ^[0-9]+$ ]]; then
  echo "Error: Port must be a number."
  exit 1
fi

if ! lsof -i :"$PORT" -P -n 2>/dev/null; then
  echo "Nothing listening on port $PORT."
  exit 1
fi
