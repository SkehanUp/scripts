ROOTS = [
    ("code", Path.home() / "Documents" / "code"),
    ("notes", Path.home() / "Documents" / "notes"),
    ("learnings", Path.home() / "Documents" / "learnings"),
]
DEFAULT_OUT = Path.home() / "Documents" / "notes" / "_registry" / "inventory.md"
DEFAULT_HTML_OUT = Path.home() / "Documents" / "notes" / "_registry" / "inventory.html"
TOPICS_REGISTRY = Path.home() / "Documents" / "notes" / "_registry" / "topics.yaml"
SKIP_NAMES = {".DS_Store", ".obsidian", ".cursor", "_registry", ".git", "__pycache__"}
SKIP_WALK_DIRS = {".git", ".venv", "node_modules", "__pycache__", ".pytest_cache", ".ruff_cache", "dist", "build"}
SUMMARY_FILES = ("CONTEXT.md", "README.md", "readme.md", "00_index.md", "00-index-and-miro-guide.md")
SUMUP_HINT_RE = re.compile(
    r"(sumup|\b(ops-ai|mock[- ]?gateway|support[- ]assistant|chatbot|chat-iframe|edge|3pba|medt|"
    r"fire-potato|hack[- ]?week|peer-review|company-announcements|alessandro)\b)",
    re.IGNORECASE,
)


@dataclass
class Entry:
    layer: str
    name: str
    path: str
    abs_path: str
    kind: str  # repo | worktree | dir | file
    scope: str  # sumup | personal
    last_ts: float
    days_ago: int
    bucket: str  # active | cooling | stale
    size_kb: int
    branch: str | None = None
    dirty: int = 0
    unpushed: int | None = None  # None = no upstream or not git
    heavy_deps: list[str] | None = None
    summary: str = ""
    files: list[str] | None = None
    preview_title: str = ""
    preview: str = ""
    parent_path: str = ""
    links: list[dict[str, str]] | None = None


def load_scope_overrides() -> dict[str, str]:
    """Read optional top-level `scopes:` mapping from topics.yaml (stdlib-only)."""
    if not TOPICS_REGISTRY.is_file():
        return {}
    overrides: dict[str, str] = {}
    in_scopes = False
    try:
        for raw in TOPICS_REGISTRY.read_text(encoding="utf-8").splitlines():
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if not raw[0].isspace():
                in_scopes = stripped == "scopes:"
                continue
            if in_scopes and ":" in stripped:
                key, val = stripped.split(":", 1)
                val = val.split("#", 1)[0].strip().strip("\"'").lower()
                if val in {"sumup", "personal"}:
                    overrides[key.strip().strip("\"'")] = val
    except OSError:
        return {}
    return overrides


def load_topic_groups() -> dict[str, list[str]]:
    """Read topic -> list of ~/Documents/... paths from topics.yaml (stdlib-only)."""
    if not TOPICS_REGISTRY.is_file():
        return {}
    groups: dict[str, list[str]] = {}
    in_topics = False
    current_topic = ""
    path_re = re.compile(r"~/Documents/(?:code|notes|learnings)/[^\s,'\"]+")
    try:
        for raw in TOPICS_REGISTRY.read_text(encoding="utf-8").splitlines():
            stripped = raw.strip()
            if not stripped or stripped.startswith("#"):
                continue
            indent = len(raw) - len(raw.lstrip(" "))
            if indent == 0:
                in_topics = stripped == "topics:"
                current_topic = ""
                continue
            if not in_topics:
                continue
            if indent == 2 and stripped.endswith(":"):
                current_topic = stripped[:-1].strip()
                groups.setdefault(current_topic, [])
                continue
            if current_topic:
                for match in path_re.findall(stripped):
                    groups[current_topic].append(match.rstrip("/"))
    except OSError:
        return {}
    return groups


def resolve_links(entries: list[Entry]) -> None:
    """Attach parent/worktree links and cross-layer topic links to entries in place."""
    by_path = {e.path: e for e in entries}
    link_map: dict[str, dict[tuple[str, str], dict[str, str]]] = {e.path: {} for e in entries}

    def add_link(src_path: str, dst: Entry, rel: str) -> None:
        if src_path == dst.path or src_path not in link_map:
            return
        key = (dst.path, rel)
        link_map[src_path][key] = {
            "label": dst.name,
            "path": dst.path,
            "layer": dst.layer,
            "rel": rel,
        }

    # 1. Worktree <-> parent repo links
    for e in entries:
        if e.parent_path and e.parent_path in by_path:
            parent = by_path[e.parent_path]
            add_link(e.path, parent, "parent repo")
            add_link(parent.path, e, "worktree")

    # 2. Cross-layer topic links from topics.yaml
    def to_entry_path(raw_path: str) -> str | None:
        parts = raw_path.split("/")
        # ~/Documents/<layer>/<entry_name>/...
        if len(parts) >= 4:
            candidate = "/".join(parts[:4])
            if candidate in by_path:
                return candidate
        return raw_path if raw_path in by_path else None

    for topic, raw_paths in load_topic_groups().items():
        matched_paths: list[str] = []
        for raw_path in raw_paths:
            ep = to_entry_path(raw_path)
            if ep and ep not in matched_paths:
                matched_paths.append(ep)
        for src in matched_paths:
            for dst_path in matched_paths:
                if dst_path != src:
                    add_link(src, by_path[dst_path], f"topic: {topic}")

    for e in entries:
        links = list(link_map[e.path].values())
        e.links = links or None


def detect_scope(
    layer: str,
    name: str,
    remote_url: str | None,
    summary: str,
    overrides: dict[str, str],
) -> str:
    override = overrides.get(f"{layer}/{name}") or overrides.get(name)
    if override:
        return override
    if remote_url:
        lowered = remote_url.lower()
        if "sumup" in lowered:
            return "sumup"
        return "personal"
    if SUMUP_HINT_RE.search(f"{name} {summary}"):
        return "sumup"
    return "personal"


def run_git(repo: Path, *args: str) -> str | None:
    try:
        res = subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return None


def get_size_kb(path: Path) -> int:
    try:
        res = subprocess.run(["du", "-sk", str(path)], capture_output=True, text=True, timeout=15)
        if res.returncode == 0 and res.stdout:
            return int(res.stdout.split()[0])
    except Exception:
        pass
    return 0


def fmt_size(kb: int) -> str:
    if kb >= 1024 * 1024:
        return f"{kb / (1024 * 1024):.1f}G"
    if kb >= 1024:
        return f"{kb / 1024:.0f}M"
    return f"{kb}K"


def newest_mtime(path: Path) -> float:
    if path.is_file():
        return path.stat().st_mtime
    newest = path.stat().st_mtime
    files_seen = 0
    for root, dirs, files in os.walk(path):
        dirs[:] = [d for d in dirs if d not in SKIP_WALK_DIRS and not d.startswith(".")]
        for fname in files:
            if fname.startswith("."):
                continue
            fpath = os.path.join(root, fname)
            try:
                mt = os.stat(fpath).st_mtime
                if mt > newest:
                    newest = mt
            except OSError:
                pass
            files_seen += 1
            if files_seen >= 400:
                return newest
    return newest


def extract_summary(path: Path) -> str:
    candidates: list[Path] = []
    if path.is_file() and path.suffix.lower() == ".md":
        candidates.append(path)
    elif path.is_dir():
        for name in SUMMARY_FILES:
            p = path / name
            if p.is_file():
                candidates.append(p)
                break
    for cand in candidates:
        try:
            with cand.open("r", encoding="utf-8", errors="ignore") as f:
                lines = [f.readline() for _ in range(30)]
        except OSError:
            continue
        in_frontmatter = False
        for idx, raw in enumerate(lines):
            line = raw.strip()
            if idx == 0 and line == "---":
                in_frontmatter = True
                continue
            if in_frontmatter:
                if line == "---":
                    in_frontmatter = False
                continue
            if not line or line.startswith(("<!--", "```", "![", "[![", "<", "|", "---")):
                continue
            cleaned = line.lstrip("#").strip()
            if cleaned:
                return cleaned[:95] + ("..." if len(cleaned) > 95 else "")
    return ""


def list_key_files(path: Path, limit: int = 24) -> list[str]:
    if not path.is_dir():
        return []
    items: list[tuple[bool, str]] = []
    try:
        for child in sorted(path.iterdir(), key=lambda p: (not p.is_dir(), p.name.lower())):
            if child.name in SKIP_WALK_DIRS or child.name.startswith("."):
                continue
            label = f"{child.name}/" if child.is_dir() else child.name
            items.append((child.is_dir(), label))
    except OSError:
        return []
    if len(items) > limit:
        shown = [label for _, label in items[:limit]]
        shown.append(f"+{len(items) - limit} more")
        return shown
    return [label for _, label in items]


def extract_preview(path: Path, max_chars: int = 2400) -> tuple[str, str]:
    target: Path | None = None
    if path.is_file() and path.suffix.lower() in {".md", ".txt", ".sh", ".yaml", ".yml", ".json"}:
        target = path
    elif path.is_dir():
        for name in SUMMARY_FILES:
            cand = path / name
            if cand.is_file():
                target = cand
                break
        if target is None:
            md_files = sorted(
                [p for p in path.iterdir() if p.is_file() and p.suffix.lower() == ".md" and not p.name.startswith(".")],
                key=lambda p: p.stat().st_mtime,
                reverse=True,
            )
            if md_files:
                target = md_files[0]
    if target is None:
        return "", ""
    try:
        text = target.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError:
        return "", ""
    if not text:
        return "", ""
    if len(text) > max_chars:
        text = text[:max_chars].rstrip() + "\n\n... (truncated)"
    return target.name, text


def inspect_entry(
    layer: str, path: Path, now: float, stale_days: int, scope_overrides: dict[str, str]
) -> Entry:
    git_marker = path / ".git"
    is_git = path.is_dir() and git_marker.exists()
    if is_git:
        kind = "worktree" if git_marker.is_file() else "repo"
    elif path.is_dir():
        kind = "dir"
    else:
        kind = "file"

    branch: str | None = None
    remote_url: str | None = None
    parent_path = ""
    dirty = 0
    unpushed: int | None = None
    last_ts = 0.0

    if is_git:
        branch = run_git(path, "rev-parse", "--abbrev-ref", "HEAD") or "detached"
        remote_url = run_git(path, "remote", "get-url", "origin")
        if kind == "worktree":
            common_dir = run_git(path, "rev-parse", "--git-common-dir")
            if common_dir:
                resolved_common = (path / common_dir).resolve()
                parent_repo = resolved_common.parent
                if parent_repo != path.resolve():
                    parent_path = str(parent_repo).replace(str(Path.home()), "~")
        porcelain = run_git(path, "status", "--porcelain")
        dirty = len(porcelain.splitlines()) if porcelain else 0
        ahead = run_git(path, "rev-list", "--count", "@{u}..HEAD")
        if ahead is not None and ahead.isdigit():
            unpushed = int(ahead)
        commit_ts = run_git(path, "log", "-1", "--format=%ct")
        if commit_ts and commit_ts.isdigit():
            last_ts = float(commit_ts)

    if last_ts == 0.0:
        last_ts = newest_mtime(path)

    days_ago = max(0, int((now - last_ts) // 86400))
    if days_ago <= 30:
        bucket = "active"
    elif days_ago <= stale_days:
        bucket = "cooling"
    else:
        bucket = "stale"

    heavy_deps: list[str] = []
    if path.is_dir():
        for dep in (".venv", "node_modules"):
            if (path / dep).exists():
                heavy_deps.append(dep)

    summary = extract_summary(path)
    scope = detect_scope(layer, path.name, remote_url, summary, scope_overrides)
    preview_title, preview = extract_preview(path)

    return Entry(
        layer=layer,
        name=path.name,
        path=str(path).replace(str(Path.home()), "~"),
        abs_path=str(path),
        kind=kind,
        scope=scope,
        last_ts=last_ts,
        days_ago=days_ago,
        bucket=bucket,
        size_kb=get_size_kb(path),
        branch=branch,
        dirty=dirty,
        unpushed=unpushed,
        heavy_deps=heavy_deps or None,
        summary=summary,
        files=list_key_files(path) or None,
        preview_title=preview_title,
        preview=preview,
        parent_path=parent_path,
    )


def scan_all(stale_days: int) -> list[Entry]:
    now = time.time()
    scope_overrides = load_scope_overrides()
    tasks: list[tuple[str, Path]] = []
    for layer, root in ROOTS:
        if not root.is_dir():
            continue
        for child in sorted(root.iterdir(), key=lambda p: p.name.lower()):
            if child.name in SKIP_NAMES or child.name.startswith("."):
                continue
            tasks.append((layer, child))

    with ThreadPoolExecutor(max_workers=12) as pool:
        futures = [
            pool.submit(inspect_entry, layer, path, now, stale_days, scope_overrides)
            for layer, path in tasks
        ]
        entries = [f.result() for f in futures]
    resolve_links(entries)
    return entries


def format_entry_line(e: Entry) -> str:
    date_str = datetime.fromtimestamp(e.last_ts, tz=timezone.utc).strftime("%Y-%m-%d")
    meta = [e.scope, f"{e.kind}", date_str, f"{e.days_ago}d ago", fmt_size(e.size_kb)]
    if e.branch:
        git_bits = [e.branch]
        if e.dirty:
            git_bits.append(f"{e.dirty} dirty")
        if e.unpushed is None:
            git_bits.append("no-upstream")
        elif e.unpushed > 0:
            git_bits.append(f"{e.unpushed} unpushed")
        meta.append("git: " + ", ".join(git_bits))
    if e.heavy_deps:
        meta.append("deps: " + "+".join(e.heavy_deps))
    line = f"- **{e.name}** (`{e.path}`) [{ ' | '.join(meta) }]"
    if e.summary:
        line += f"\n  - {e.summary}"
    return line


def render_markdown(entries: list[Entry], stale_days: int, only_stale: bool) -> str:
    generated = datetime.now().strftime("%Y-%m-%d %H:%M")
    active = [e for e in entries if e.bucket == "active"]
    cooling = [e for e in entries if e.bucket == "cooling"]
    stale = [e for e in entries if e.bucket == "stale"]
    total_kb = sum(e.size_kb for e in entries)

    out = [
        "# Workspace inventory",
        "",
        f"Generated: {generated} by `ws-index`. Total: {len(entries)} items ({fmt_size(total_kb)}) "
        f"| Active (<=30d): {len(active)} | Cooling (31-{stale_days}d): {len(cooling)} | Stale (>{stale_days}d): {len(stale)}.",
        "",
    ]

    layers = ["code", "learnings", "notes"]
    buckets = [("stale", f"Stale (>{stale_days}d)")] if only_stale else [
        ("active", "Active (<=30d)"),
        ("cooling", f"Cooling (31-{stale_days}d)"),
        ("stale", f"Stale (>{stale_days}d)"),
    ]

    for layer in layers:
        layer_items = [e for e in entries if e.layer == layer]
        if not layer_items:
            continue
        layer_kb = sum(e.size_kb for e in layer_items)
        out.append(f"## {layer} ({len(layer_items)} items, {fmt_size(layer_kb)})")
        out.append("")
        for bucket_key, bucket_label in buckets:
            group = sorted(
                [e for e in layer_items if e.bucket == bucket_key],
                key=lambda x: x.last_ts,
                reverse=True,
            )
            if not group:
                continue
            out.append(f"### {bucket_label}")
            for e in group:
                out.append(format_entry_line(e))
            out.append("")

    return "\n".join(out).rstrip() + "\n"


def render_html(entries: list[Entry], stale_days: int) -> str:
    generated = datetime.now().strftime("%Y-%m-%d %H:%M")
    payload = []
    for e in entries:
        date_str = datetime.fromtimestamp(e.last_ts, tz=timezone.utc).strftime("%Y-%m-%d")
        obs_target = ""
        if e.layer == "notes" or e.abs_path.endswith(".md") or (e.preview_title and e.preview_title.endswith(".md")):
            obs_target = str(Path(e.abs_path) / e.preview_title) if (e.kind != "file" and e.preview_title) else e.abs_path
        attention = bool(
            e.dirty
            or (e.unpushed is not None and e.unpushed > 0)
            or e.heavy_deps
            or (e.kind == "worktree" and e.days_ago > 14)
        )
        payload.append({
            "layer": e.layer,
            "name": e.name,
            "path": e.path,
            "absPath": e.abs_path,
            "kind": e.kind,
            "scope": e.scope,
            "lastTs": e.last_ts,
            "date": date_str,
            "days": e.days_ago,
            "bucket": e.bucket,
            "sizeKb": e.size_kb,
            "size": fmt_size(e.size_kb),
            "branch": e.branch,
            "dirty": e.dirty,
            "unpushed": e.unpushed,
            "deps": e.heavy_deps or [],
            "summary": e.summary,
            "files": e.files or [],
            "previewTitle": e.preview_title,
            "preview": e.preview,
            "links": e.links or [],
            "obsUrl": f"obsidian://open?path={quote(obs_target)}" if obs_target else "",
            "attention": attention,
        })

    data_json = json.dumps(payload).replace("</", "<\\/")

    return f"""<!doctype html>
