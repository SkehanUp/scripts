.link-chip {{
  display:inline-flex; align-items:center; gap:5px; padding:3px 9px; border-radius:6px;
  border:1px solid var(--border); background:var(--surface); color:var(--fg);
  font-size:12px; cursor:pointer; transition:border-color .15s;
}}
.link-chip:hover {{ border-color:var(--cyan); color:var(--cyan); }}
.link-rel {{ font-size:10.5px; color:var(--subtle); }}
details.row.flash {{ border-color:var(--cyan); box-shadow:0 0 0 2px rgba(139,233,253,0.28); }}

details.row {{
  background:var(--surface); border:1px solid var(--border); border-radius:9px;
  margin-bottom:7px; transition:border-color .15s;
}}
details.row:hover {{ border-color:#454860; }}
details.row[open] {{ border-color:var(--purple); }}
summary.row-head {{
  list-style:none; padding:10px 14px; cursor:pointer;
  display:flex; justify-content:space-between; align-items:center; gap:14px;
}}
summary.row-head::-webkit-details-marker {{ display:none; }}
.row-left {{ min-width:0; flex:1; }}
.row-title {{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }}
.name {{ font-weight:600; font-size:14px; color:var(--fg); }}
.summary {{ color:var(--muted); font-size:12.5px; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }}
.row-right {{ display:flex; align-items:center; gap:10px; flex:none; font-size:12px; font-variant-numeric:tabular-nums; }}
.flag {{ font-size:11px; padding:2px 6px; border-radius:5px; background:#2e3142; color:var(--orange); }}
.flag-muted {{ color:var(--muted); }}
.age {{ display:flex; align-items:center; gap:5px; color:var(--muted); min-width:44px; justify-content:flex-end; }}
.size {{ color:var(--muted); min-width:46px; text-align:right; }}

/* Expanded drawer */
.drawer {{ border-top:1px solid var(--border); padding:12px 14px; background:var(--surface2); border-radius:0 0 9px 9px; }}
.drawer-top {{ display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:12px; }}
.drawer-path {{ font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; color:var(--muted); }}
.drawer-git {{ font-size:12px; color:var(--subtle); margin-top:2px; }}
.actions {{ display:flex; flex-wrap:wrap; gap:6px; }}
.act {{
  padding:4px 9px; border-radius:6px; border:1px solid var(--border); background:var(--surface);
  color:var(--cyan); text-decoration:none; font-size:12px; cursor:pointer;
}}
.act:hover {{ border-color:var(--cyan); }}
.drawer-grid {{ display:grid; grid-template-columns:240px 1fr; gap:14px; }}
@media (max-width:760px) {{ .drawer-grid {{ grid-template-columns:1fr; }} }}
.drawer-grid.single {{ grid-template-columns:1fr; }}
.sub-label {{ font-size:11px; text-transform:uppercase; letter-spacing:0.05em; color:var(--subtle); margin-bottom:6px; }}
.file-list {{ list-style:none; margin:0; padding:0; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; max-height:320px; overflow:auto; }}
.file-list li {{ padding:2px 0; color:#cfd3e3; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }}
.file-list li.dir {{ color:var(--purple); }}
.md-box {{
  background:#15161e; border:1px solid #2b2d3c; border-radius:8px; padding:12px 14px;
  max-height:340px; overflow:auto; font-size:13px; line-height:1.55; color:#dce0ee;
}}
.md-box h1,.md-box h2,.md-box h3 {{ margin:10px 0 6px; font-size:14px; color:var(--fg); }}
.md-box h1:first-child,.md-box h2:first-child,.md-box h3:first-child {{ margin-top:0; }}
.md-box p {{ margin:0 0 8px; }}
.md-box ul {{ margin:0 0 8px; padding-left:18px; }}
.md-box code {{ font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:12px; background:#252736; padding:1px 4px; border-radius:4px; color:var(--cyan); }}
.md-box pre {{ background:#1d1f2b; padding:8px 10px; border-radius:6px; overflow:auto; margin:6px 0; }}
.md-box pre code {{ background:none; padding:0; color:#dce0ee; }}
.md-box a {{ color:var(--cyan); }}
.empty-state {{ text-align:center; padding:48px 16px; color:var(--muted); }}
</style></head><body>
<header>
  <h1>Workspace Inventory</h1>
  <div class="gen">Generated {generated} · Stale threshold &gt;{stale_days}d · Press / to search</div>
</header>

<div class="kpis" id="kpis"></div>

<div class="toolbar">
  <div class="search-wrap">
    <input id="q" placeholder="Search name, files, branch, or summary...">
    <button id="clearQ" class="clear-btn" title="Clear">&times;</button>
  </div>
  <div class="tab-group">
    <span class="tab-group-label">Scope</span>
    <div class="tabs" id="scopeTabs"></div>
  </div>
  <div class="tab-group">
    <span class="tab-group-label">Layer</span>
    <div class="tabs" id="layerTabs"></div>
  </div>
  <select id="sortSel" aria-label="Sort by">
    <option value="recent">Sort: Most recent</option>
    <option value="size">Sort: Largest first</option>
    <option value="oldest">Sort: Oldest first</option>
    <option value="name">Sort: Name A-Z</option>
  </select>
</div>

<main id="app"></main>

<script type="application/json" id="ws-data">{data_json}</script>
<script>
const ITEMS = JSON.parse(document.getElementById('ws-data').textContent);
const state = {{ scope: 'all', layer: 'all', bucket: 'all', attn: false, q: '', sort: 'recent' }};

function esc(s) {{
  return String(s ?? '').replace(/[&<>"']/g, c => ({{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}}[c]));
}}
function fmtSize(kb) {{
  if (kb >= 1048576) return (kb / 1048576).toFixed(1) + 'G';
  if (kb >= 1024) return Math.round(kb / 1024) + 'M';
  return kb + 'K';
}}
function renderMd(raw) {{
  const lines = raw.split('\\n');
  let out = [], inCode = false, inUl = false;
  const inline = t => esc(t)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>')
    .replace(/\\[([^\\]]+)\\]\\((https?:\\/\\/[^)]+)\\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');
  for (const line of lines) {{
    if (line.trim().startsWith('```')) {{
      if (inUl) {{ out.push('</ul>'); inUl = false; }}
      out.push(inCode ? '</code></pre>' : '<pre><code>');
      inCode = !inCode;
      continue;
    }}
    if (inCode) {{ out.push(esc(line) + '\\n'); continue; }}
    const trimmed = line.trim();
    if (!trimmed) {{
      if (inUl) {{ out.push('</ul>'); inUl = false; }}
      continue;
    }}
    const hm = trimmed.match(/^(#{{1,3}})\\s+(.+)/);
    if (hm) {{
      if (inUl) {{ out.push('</ul>'); inUl = false; }}
      const lvl = hm[1].length;
      out.push(`<h${{lvl}}>${{inline(hm[2])}}</h${{lvl}}>`);
      continue;
    }}
    const lm = trimmed.match(/^[-*]\\s+(.+)/);
    if (lm) {{
      if (!inUl) {{ out.push('<ul>'); inUl = true; }}
      out.push(`<li>${{inline(lm[1])}}</li>`);
      continue;
    }}
    if (inUl) {{ out.push('</ul>'); inUl = false; }}
    out.push(`<p>${{inline(trimmed)}}</p>`);
  }}
  if (inUl) out.push('</ul>');
  if (inCode) out.push('</code></pre>');
  return out.join('');
}}

function matchesSearch(item, q) {{
  if (!q) return true;
  const hay = (item.name + ' ' + item.scope + ' ' + item.layer + ' ' + item.path + ' ' + (item.branch || '') + ' ' + item.summary + ' ' + item.files.join(' ')).toLowerCase();
  return hay.includes(q);
}}

function renderKpis() {{
  const base = ITEMS.filter(i =>
    (state.scope === 'all' || i.scope === state.scope) &&
    (state.layer === 'all' || i.layer === state.layer) &&
    matchesSearch(i, state.q)
  );
  const totalKb = base.reduce((s, i) => s + i.sizeKb, 0);
  const cActive = base.filter(i => i.bucket === 'active').length;
  const cCooling = base.filter(i => i.bucket === 'cooling').length;
  const cStale = base.filter(i => i.bucket === 'stale').length;
  const cAttn = base.filter(i => i.attention).length;

  const cards = [
    {{ id:'all', label:'All items', val:base.length, sub:fmtSize(totalKb) + ' total', dot:'', active: !state.attn && state.bucket==='all' }},
    {{ id:'active', label:'Active', val:cActive, sub:'<= 30 days', dot:'dot-active', active: !state.attn && state.bucket==='active' }},
    {{ id:'cooling', label:'Cooling', val:cCooling, sub:'31 - {stale_days} days', dot:'dot-cooling', active: !state.attn && state.bucket==='cooling' }},
    {{ id:'stale', label:'Stale', val:cStale, sub:'> {stale_days} days', dot:'dot-stale', active: !state.attn && state.bucket==='stale' }},
    {{ id:'attn', label:'Needs attention', val:cAttn, sub:'dirty, unpushed, deps', dot:'dot-attn', active: state.attn }},
  ];
  document.getElementById('kpis').innerHTML = cards.map(c => `
    <button class="kpi ${{c.active ? 'active' : ''}}" data-kpi="${{c.id}}">
      <div class="kpi-label">${{c.dot ? `<span class="dot ${{c.dot}}"></span>` : ''}}${{c.label}}</div>
      <div class="kpi-val">${{c.val}}</div>
      <div class="kpi-sub">${{c.sub}}</div>
    </button>
  `).join('');
  document.querySelectorAll('.kpi').forEach(btn => btn.onclick = () => {{
    const id = btn.dataset.kpi;
    if (id === 'attn') {{ state.attn = !state.attn; if (state.attn) state.bucket = 'all'; }}
    else {{ state.attn = false; state.bucket = id; }}
    render();
  }});
}}

function renderTabs() {{
  const scopeBase = ITEMS.filter(i =>
    (state.layer === 'all' || i.layer === state.layer) &&
    matchesSearch(i, state.q) &&
    (state.attn ? i.attention : (state.bucket === 'all' || i.bucket === state.bucket))
  );
  const scopeCounts = {{ all: scopeBase.length, sumup: 0, personal: 0 }};
  scopeBase.forEach(i => scopeCounts[i.scope]++);
  const scopeLabels = {{ all: 'All', sumup: 'SumUp', personal: 'Personal' }};
  document.getElementById('scopeTabs').innerHTML = ['all', 'sumup', 'personal'].map(s => `
    <button class="tab ${{state.scope === s ? 'active' : ''}}" data-scope="${{s}}">
      ${{scopeLabels[s]}}<span>${{scopeCounts[s]}}</span>
    </button>
  `).join('');
  document.querySelectorAll('#scopeTabs .tab').forEach(btn => btn.onclick = () => {{
    state.scope = btn.dataset.scope;
    render();
  }});

  const base = ITEMS.filter(i =>
    (state.scope === 'all' || i.scope === state.scope) &&
    matchesSearch(i, state.q) &&
    (state.attn ? i.attention : (state.bucket === 'all' || i.bucket === state.bucket))
  );
  const counts = {{ all: base.length, code: 0, learnings: 0, notes: 0 }};
  base.forEach(i => counts[i.layer]++);
  document.getElementById('layerTabs').innerHTML = ['all','code','learnings','notes'].map(l => `
    <button class="tab ${{state.layer === l ? 'active' : ''}}" data-layer="${{l}}">
      ${{l === 'all' ? 'All' : l}}<span>${{counts[l]}}</span>
    </button>
  `).join('');
  document.querySelectorAll('#layerTabs .tab').forEach(btn => btn.onclick = () => {{
    state.layer = btn.dataset.layer;
    render();
  }});
}}

function sortItems(list) {{
  const copy = [...list];
  if (state.sort === 'recent') copy.sort((a, b) => b.lastTs - a.lastTs);
  else if (state.sort === 'oldest') copy.sort((a, b) => a.lastTs - b.lastTs);
  else if (state.sort === 'size') copy.sort((a, b) => b.sizeKb - a.sizeKb);
  else if (state.sort === 'name') copy.sort((a, b) => a.name.localeCompare(b.name));
  return copy;
}}

function renderRow(i) {{
  const flags = [];
  if (i.dirty) flags.push(`<span class="flag">${{i.dirty}} dirty</span>`);
  if (i.unpushed > 0) flags.push(`<span class="flag">${{i.unpushed}} unpushed</span>`);
  if (i.kind === 'worktree') flags.push(`<span class="flag flag-muted">worktree</span>`);
  if (i.links.length) flags.push(`<span class="flag flag-muted">${{i.links.length}} linked</span>`);
  if (i.deps.length) flags.push(`<span class="flag flag-muted">${{esc(i.deps.join('+'))}}</span>`);

  const scopeTag = `<span class="scope-badge s-${{i.scope}}">${{i.scope === 'sumup' ? 'SumUp' : 'Personal'}}</span>`;
  const layerTag = state.layer === 'all' ? `<span class="layer-badge">${{i.layer}}</span>` : '';
  const gitLine = i.branch
    ? `git: ${{esc(i.branch)}}${{i.dirty ? ' · ' + i.dirty + ' dirty' : ''}}${{i.unpushed === null ? ' · no-upstream' : (i.unpushed > 0 ? ' · ' + i.unpushed + ' unpushed' : '')}}`
    : i.kind;

  const actions = [
    `<button type="button" class="act" data-copy="${{esc(i.path)}}">Copy path</button>`,
  ];
  if (i.kind !== 'file') {{
    actions.push(`<button type="button" class="act" data-copy="${{esc('cd ' + JSON.stringify(i.absPath) + ' && opencode')}}">Copy opencode cmd</button>`);
  }}
  if (i.obsUrl) {{
    actions.push(`<a class="act" href="${{i.obsUrl}}">Open in Obsidian</a>`);
  }}

  const filesCol = i.files.length ? `
    <div>
      <div class="sub-label">Files (${{i.files.length}})</div>
      <ul class="file-list">${{i.files.map(f => `<li class="${{f.endsWith('/') ? 'dir' : ''}}">${{esc(f)}}</li>`).join('')}}</ul>
    </div>` : '';

  const previewCol = i.preview ? `
    <div>
      <div class="sub-label">Preview: ${{esc(i.previewTitle)}}</div>
      <div class="md-box">${{renderMd(i.preview)}}</div>
    </div>` : (!i.files.length ? `<div class="drawer-git">Empty folder or no readable preview.</div>` : '');

  const linksBar = i.links.length ? `
    <div class="links-bar">
      <span class="sub-label" style="margin:0">Linked</span>
      ${{i.links.map(l => `<button type="button" class="link-chip" data-jump="${{esc(l.path)}}">${{esc(l.label)}} <span class="link-rel">${{esc(l.rel)}}</span></button>`).join('')}}
    </div>` : '';

  const gridClass = (filesCol && previewCol) ? 'drawer-grid' : 'drawer-grid single';

  return `
    <details class="row" data-path="${{esc(i.path)}}">
      <summary class="row-head">
        <div class="row-left">
          <div class="row-title"><span class="name">${{esc(i.name)}}</span>${{scopeTag}}${{layerTag}}</div>
          ${{i.summary ? `<div class="summary">${{esc(i.summary)}}</div>` : ''}}
        </div>
        <div class="row-right">
          ${{flags.join('')}}
          <span class="size">${{esc(i.size)}}</span>
          <span class="age"><span class="dot dot-${{i.bucket}}"></span>${{i.days}}d</span>
        </div>
      </summary>
      <div class="drawer">
        <div class="drawer-top">
          <div>
            <div class="drawer-path">${{esc(i.path)}} · ${{esc(i.date)}}</div>
            <div class="drawer-git">${{gitLine}}</div>
          </div>
          <div class="actions">${{actions.join('')}}</div>
        </div>
        ${{linksBar}}
        <div class="${{gridClass}}">${{filesCol}}${{previewCol}}</div>
      </div>
    </details>
  `;
}}

function render() {{
  renderKpis();
  renderTabs();
  const filtered = ITEMS.filter(i =>
    (state.scope === 'all' || i.scope === state.scope) &&
    (state.layer === 'all' || i.layer === state.layer) &&
    (state.attn ? i.attention : (state.bucket === 'all' || i.bucket === state.bucket)) &&
    matchesSearch(i, state.q)
  );

  const app = document.getElementById('app');
  if (!filtered.length) {{
    app.innerHTML = '<div class="empty-state">No matching items.</div>';
    return;
  }}

  const groupBy = state.layer === 'all' ? 'layer' : 'bucket';
  const order = groupBy === 'layer' ? ['code', 'learnings', 'notes'] : ['active', 'cooling', 'stale'];
  const labels = {{ active: 'Active (<= 30d)', cooling: 'Cooling (31 - {stale_days}d)', stale: 'Stale (> {stale_days}d)', code: 'code', learnings: 'learnings', notes: 'notes' }};

  const sections = [];
  for (const key of order) {{
    const grp = sortItems(filtered.filter(i => i[groupBy] === key));
    if (!grp.length) continue;
    const kb = grp.reduce((s, i) => s + i.sizeKb, 0);
    const dot = groupBy === 'bucket' ? `<span class="dot dot-${{key}}"></span>` : '';
    sections.push(`
      <section class="section">
        <div class="section-head">
          <div class="section-title">${{dot}}${{labels[key]}}</div>
          <div class="section-meta">${{grp.length}} items · ${{fmtSize(kb)}}</div>
        </div>
        ${{grp.map(renderRow).join('')}}
      </section>
    `);
  }}
  app.innerHTML = sections.join('');
  app.querySelectorAll('[data-copy]').forEach(btn => btn.onclick = e => {{
    e.stopPropagation();
    navigator.clipboard.writeText(btn.dataset.copy);
    const orig = btn.textContent;
    btn.textContent = 'Copied';
    setTimeout(() => btn.textContent = orig, 1000);
  }});
  app.querySelectorAll('[data-jump]').forEach(btn => btn.onclick = e => {{
    e.stopPropagation();
    const targetPath = btn.dataset.jump;
    let el = document.querySelector(`details.row[data-path="${{CSS.escape(targetPath)}}"]`);
    if (!el) {{
      state.scope = 'all'; state.layer = 'all'; state.bucket = 'all'; state.attn = false; state.q = '';
      qInput.value = ''; clearBtn.style.display = 'none';
      render();
      el = document.querySelector(`details.row[data-path="${{CSS.escape(targetPath)}}"]`);
    }}
    if (el) {{
      el.open = true;
      el.scrollIntoView({{ behavior: 'smooth', block: 'center' }});
      el.classList.add('flash');
      setTimeout(() => el.classList.remove('flash'), 1400);
    }}
  }});
}}

const qInput = document.getElementById('q');
const clearBtn = document.getElementById('clearQ');
qInput.oninput = () => {{
  state.q = qInput.value.trim().toLowerCase();
  clearBtn.style.display = state.q ? 'block' : 'none';
  render();
}};
clearBtn.onclick = () => {{ qInput.value = ''; state.q = ''; clearBtn.style.display = 'none'; qInput.focus(); render(); }};
document.getElementById('sortSel').onchange = e => {{ state.sort = e.target.value; render(); }};
document.addEventListener('keydown', e => {{
  if (e.key === '/' && document.activeElement !== qInput) {{ e.preventDefault(); qInput.focus(); }}
  else if (e.key === 'Escape' && document.activeElement === qInput) {{ qInput.blur(); }}
}});

render();
</script></body></html>
"""


def main() -> int:
    parser = argparse.ArgumentParser(description="Live inventory of ~/Documents/{code,notes,learnings}.")
    parser.add_argument("query", nargs="?", help="Filter entries by name, path, branch, or summary.")
    parser.add_argument("--stale", action="store_true", help="Show only stale items.")
    parser.add_argument("--scope", choices=["sumup", "personal"], help="Filter by scope (sumup or personal).")
    parser.add_argument("--days", type=int, default=90, help="Staleness threshold in days (default: 90).")
    parser.add_argument("--write", action="store_true", help=f"Write Markdown + HTML reports to {DEFAULT_OUT.parent}.")
    parser.add_argument("--open", action="store_true", help="Open HTML report in default browser (implies --write).")
    parser.add_argument("--json", action="store_true", help="Output JSON.")
    args = parser.parse_args()

    entries = scan_all(args.days)

    if args.query:
        q = args.query.lower()
        entries = [
            e for e in entries
            if q in e.name.lower()
            or q in e.path.lower()
            or (e.branch and q in e.branch.lower())
            or q in e.summary.lower()
        ]
    if args.stale:
        entries = [e for e in entries if e.bucket == "stale"]
    if args.scope:
        entries = [e for e in entries if e.scope == args.scope]

    if args.json:
        print(json.dumps([asdict(e) for e in entries], indent=2))
        return 0

    md = render_markdown(entries, args.days, args.stale)
    if args.write or args.open:
        DEFAULT_OUT.parent.mkdir(parents=True, exist_ok=True)
        DEFAULT_OUT.write_text(md, encoding="utf-8")
        DEFAULT_HTML_OUT.write_text(render_html(entries, args.days), encoding="utf-8")
        print(f"Wrote {DEFAULT_OUT} and {DEFAULT_HTML_OUT} ({len(entries)} items).")
        if args.open:
            subprocess.run(["open", str(DEFAULT_HTML_OUT)], check=False)
    else:
        sys.stdout.write(md)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
