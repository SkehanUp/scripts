#!/usr/bin/env bash

# Usage: curlhost <virtual-host> <url-or-ip> [curl-options...]
# Description: Send a custom Host header to probe virtual hosts on a shared IP.

set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: curlhost <virtual-host> <url-or-ip> [curl-options...]"
  echo "Example: curlhost staging.example.com 203.0.113.5"
  exit 1
fi

VHOST="$1"
TARGET="$2"
shift 2

if [[ "$TARGET" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  URL="http://$TARGET/"
elif [[ "$TARGET" == http://* || "$TARGET" == https://* ]]; then
  URL="$TARGET"
else
  URL="http://$TARGET/"
fi

exec curl -sS -H "Host: $VHOST" "$@" "$URL"
