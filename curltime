#!/usr/bin/env bash

# Usage: curltime <url> [curl-options...]
# Description: Print DNS, TLS handshake, and TTFB timing breakdown for a URL.

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: curltime <url> [curl-options...]"
  exit 1
fi

URL="$1"
shift

curl -o /dev/null -sS "$@" -w "\
DNS lookup:         %{time_namelookup}s
TCP connect:        %{time_connect}s
TLS handshake:      %{time_appconnect}s
Time to first byte: %{time_starttransfer}s
Total:              %{time_total}s
HTTP code:          %{http_code}
" "$URL"
