#!/usr/bin/env bash
# Usage: cursor-agent [args]
# Description: Shim to Cursor Agent CLI (installed by Cursor, not vendored here).
set -euo pipefail

find_cursor_agent() {
  local candidate
  for candidate in "$HOME"/.local/share/cursor-agent/versions/*/cursor-agent; do
    [[ -x "$candidate" ]] || continue
    grep -q 'SCRIPT_DIR=.*realpath' "$candidate" || continue
    printf '%s\n' "$candidate"
    return 0
  done
  return 1
}

REAL="$(find_cursor_agent || true)"
if [[ -z "$REAL" ]]; then
  echo "cursor-agent not found; install from https://cursor.com" >&2
  exit 1
fi
exec "$REAL" "$@"
